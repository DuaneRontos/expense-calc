<component name="ProjectRunConfigurationManager">
  <!--
    The deployed behaviour: no profile, so authentication is on.

    **It needs three environment variables, not two**, or SecurityStartupGuard
    refuses to boot — which is the point of it:

        APP_AUTH_USERNAME
        APP_AUTH_PASSWORD_HASH
        APP_AUTH_JWT_SECRET

    They are deliberately not committed here. A hash in this file would be a
    published password, and a placeholder is worse than nothing: `$argon2id$`
    is not parseable by Argon2PasswordEncoder, so it fails at sign-in rather
    than at startup, which is much further from the cause.

    Put real values in this configuration's **Environment variables** field.
    "Option B" in docs/RUNNING-LOCALLY.md has the command that generates a hash.
  -->
  <configuration default="false" name="Backend (secured)" type="SpringBootApplicationConfigurationType" factoryName="Spring Boot">
    <envs />
    <module name="expense-calc-backend" />
    <option name="SPRING_BOOT_MAIN_CLASS" value="com.duanerontos.expensecalc.ExpenseCalcBackendApplication" />
    <method v="2">
      <option name="Make" enabled="true" />
    </method>
  </configuration>
</component>
