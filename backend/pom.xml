<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
		spring-boot-starter-parent supplies dependency management and plugin
		configuration. It is the Maven equivalent of the Gradle
		io.spring.dependency-management plugin this build previously used, and
		it is why no dependency below carries a version.
	-->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/>
	</parent>

	<groupId>com.duanerontos</groupId>
	<artifactId>expense-calc-backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>expense-calc-backend</name>
	<description>Expense calculator API: classification, query, and reporting</description>

	<properties>
		<!--
			Drives maven.compiler.release, so the compiler enforces Java 21 APIs
			and bytecode regardless of which JDK runs the build. This is why
			Maven needs no equivalent of Gradle's Foojay toolchain resolver: a
			newer JDK compiles a correct Java 21 artifact rather than having to
			download a matching one.
		-->
		<java.version>21</java.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<!-- Boot 4 renamed this from spring-boot-starter-web. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!--
			Boot 4 splits test support per module rather than shipping one
			spring-boot-starter-test. Removing any of these silently drops a
			test slice: -data-jpa-test carries @DataJpaTest and TestEntityManager,
			-webmvc-test carries the MVC slice.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
			Boot 4 moved TestRestTemplate out of spring-boot-test into its own
			module: org.springframework.boot.resttestclient. The Boot 3 package
			org.springframework.boot.test.web.client no longer exists, so a
			copied snippet fails to compile with a bare "package does not
			exist". Needed by BackendOperabilityTest, which drives the running
			app over HTTP.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-resttestclient</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
			TestRestTemplate builds on RestTemplateBuilder, which Boot 4 split
			into spring-boot-restclient. Without it the context fails at startup
			with NoClassDefFoundError: RestTemplateBuilder, surfacing as
			"@ConditionalOnMissingBean ... failed to deduce the bean's type" —
			a message naming neither the missing class nor the missing module.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-restclient</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
