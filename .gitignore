# =============================================================
# expense-calc — Java Spring Boot backend + Expo/React Native frontend
# Replaces the Go template the repo was initialized with.
# =============================================================

# ---------- Java / JVM ----------
*.class
*.log
hs_err_pid*
replay_pid*

# ---------- Gradle ----------
.gradle/
build/
gradle-app.setting
.gradletasknamecache
# The wrapper jar and properties MUST be committed — never blanket-ignore *.jar
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# ---------- Maven ----------
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
!.mvn/wrapper/maven-wrapper.jar

# ---------- Spring Boot ----------
# Local overrides; the committed application.yml stays tracked
application-local.yml
application-local.properties
application-secrets.yml

# ---------- Node / JavaScript ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
.eslintcache

# ---------- Expo / React Native ----------
.expo/
.expo-shared/
dist/
web-build/
.metro-health-check*
*.jsbundle

# ---------- iOS ----------
ios/Pods/
ios/build/
ios/.xcode.env.local
DerivedData/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# ---------- Android ----------
android/.gradle/
android/build/
android/app/build/
android/local.properties
*.apk
*.aab
# Signing keys must never be committed. RN ships a shared debug keystore —
# that one is safe and expected in version control.
*.keystore
!android/app/debug.keystore

# ---------- Secrets and environment ----------
.env
.env.*
!.env.example
*.pem
*.p12
*.p8
*.mobileprovision

# ---------- Editors and OS ----------
.idea/
*.iml
*.iws
*.ipr
.vscode/
!.vscode/extensions.json
.settings/
.classpath
.project
.DS_Store
Thumbs.db

# ---------- Test and coverage output ----------
coverage/
.nyc_output/
*.lcov
